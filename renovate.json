  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/fluxcd/**"
      ],
      "groupName": "fluxcd controllers",
      "groupSlug": "fluxcd-controllers"
    }
  ]
}
